POSTGRES_USER=credit_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=credit_risk
POSTGRES_HOST=db
POSTGRES_PORT=5432

APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=Credit Risk Scoring Service
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

MODEL_BUNDLE_PATH=artifacts/models/production_model_bundle.joblib
INFERENCE_LOGGING_ENABLED=true
DATABASE_REQUIRED=true
TOP_REASON_CODES=5
MAX_BATCH_SIZE=1000
BATCH_STORAGE_DIR=artifacts/uploads
BATCH_OUTPUT_DIR=artifacts/predictions
BATCH_MAX_UPLOAD_BYTES=50000000
BATCH_MAX_ROWS=100000
BATCH_WORKER_POLL_SECONDS=2
BATCH_RETAIN_INPUTS=false
# Set a strong random value in production. Leave empty only for local development.
API_KEY=
# Required for /v1/partner/postback in every environment.
PARTNER_POSTBACK_SECRET=
OFFER_CONFIG_PATH=configs/offers.yaml
OFFER_REFERENCE_ANNUAL_RATE=0.24
OFFER_RANKER_MODE=rules
OFFER_RANKER_MIN_SAMPLES=200
PERSIST_EXACT_COMMERCIAL_VALUES=false
