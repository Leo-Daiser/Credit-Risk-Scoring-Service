POSTGRES_USER=credit_user
POSTGRES_PASSWORD=credit_pass
POSTGRES_DB=credit_risk
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Local/demo compose derives DATABASE_URL from the POSTGRES_* values above.
# Public deployments must set an explicit secret-managed DATABASE_URL.

APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=Riskline
# local | demo | public. Public mode requires the strict settings documented below.
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json

MODEL_BUNDLE_PATH=artifacts/models/production_model_bundle.joblib
MODEL_BUNDLE_REQUIRED=false
INFERENCE_LOGGING_ENABLED=true
DATABASE_REQUIRED=true
TOP_REASON_CODES=5
MAX_BATCH_SIZE=1000
BATCH_STORAGE_DIR=artifacts/uploads
BATCH_OUTPUT_DIR=artifacts/predictions
BATCH_MAX_UPLOAD_BYTES=50000000
BATCH_MAX_ROWS=100000
BATCH_WORKER_POLL_SECONDS=2
BATCH_RETAIN_INPUTS=false
# Local-only placeholder. Replace with a strong random value before public deployment.
API_KEY=change-me-local-operator-key
# Required only when partner callbacks are enabled. Generate it outside Git.
PARTNER_POSTBACKS_ENABLED=true
PARTNER_POSTBACK_SECRET=local-demo-postback-secret
PARTNER_CONFIG_PATH=configs/partners.yaml
EXPERIMENT_CONFIG_PATH=configs/experiments.yaml
DEMO_MODE=true
PUBLIC_SAFE_DEMO_ADAPTER_ENABLED=false
REAL_PARTNER_ENABLED=false
REAL_PARTNER_SECRET=
OPERATOR_UI_ENABLED=true
PUBLIC_AUTH_STRICT=false
# Public deployment example (uncomment and provide a real random API_KEY):
# APP_ENV=public
# DEMO_MODE=false
# OPERATOR_UI_ENABLED=false
# PUBLIC_AUTH_STRICT=true
# DATABASE_URL=<secret-managed production DSN>
# API_KEY=<strong random operator/BFF key>
# PARTNER_POSTBACKS_ENABLED=false
BACKEND_URL=http://api:8000
OFFER_CONFIG_PATH=configs/offers.yaml
OFFER_REFERENCE_ANNUAL_RATE=0.24
OFFER_RANKER_MODE=rules
OFFER_RANKER_MIN_SAMPLES=200
PERSIST_EXACT_COMMERCIAL_VALUES=false
ANALYTICS_DEFAULT_DAYS=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PROFILE_SCORE=60
RATE_LIMIT_OFFER_MATCH=30
RATE_LIMIT_OFFER_CLICK=60
RATE_LIMIT_PUBLIC_EVENT=120
RATE_LIMIT_PARTNER_POSTBACK=30
RATE_LIMIT_INVALID_POSTBACK=8
